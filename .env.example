# LLM 接入配置（兼容 OpenAI / OpenRouter / DeepSeek / 通义千问 等所有 OpenAI 协议）
#
# 例：OpenRouter（聚合多家模型，一个 key 全用）
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=deepseek/deepseek-chat        # 也可以换 google/gemini-2.5-flash 等
# 例：DeepSeek 官方
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
# 例：通义千问
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen-plus
# 例：OpenAI 官方
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat

# 仅 OpenRouter 用（可选，用于排行榜归属）
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Simple Agent

PORT=3001
