{
  "name": "simple-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "一个通用的 JS Agent 框架 + 30 秒生成 web 小应用的对话式工作台",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
